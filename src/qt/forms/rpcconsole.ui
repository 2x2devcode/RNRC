         </property>
        </widget>
       </item>
       <item row="3" column="0" colspan="2">
        <widget class="QPushButton" name="btn_salvagewallet">
         <property name="text">
          <string>Salvage wallet</string>
         </property>
        </widget>
       </item>
       <item row="3" column="2">
        <widget class="QLabel" name="label_repair_salvage_command">
         <property name="text">
