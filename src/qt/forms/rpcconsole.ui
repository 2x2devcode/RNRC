          <string>Rescan blockchain files</string>
         </property>
        </widget>
       </item>
       <item row="4" column="2">
        <widget class="QLabel" name="label_repair_rescan_command">
         <property name="text">
          <string notr="true">-rescan:</string>
         </property>
        </widget>
       </item>
       <item row="4" column="3">
        <widget class="QLabel" name="label_repair_rescan">
